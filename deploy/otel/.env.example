# deploy/otel — single source of truth for every variable in the stack.
# Copy to .env next to docker-compose.yml and adjust. Nothing below is
# hardcoded anywhere else; compose, collector config, and scripts all
# interpolate from here.

# ---- host ports (all >10000 to avoid collisions with standard services) ----
ASPIRE_UI_PORT=18901          # Aspire dashboard web UI
OTLP_GRPC_PORT=14317          # collector OTLP/gRPC ingest (apps point here)
OTLP_HTTP_PORT=14318          # collector OTLP/HTTP ingest
BRIDGE_PORT=18902             # Cosmos bridge HTTP (collector-internal, exposed for debug)
COLLECTOR_HEALTH_PORT=14313   # collector health_check extension
COSMOS_EMULATOR_PORT=18081    # Cosmos DB emulator gateway (profile: cosmos)

# ---- images (pinned; bump deliberately) ----
ASPIRE_DASHBOARD_IMAGE=mcr.microsoft.com/dotnet/aspire-dashboard:13.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.158.0
COSMOS_EMULATOR_IMAGE=mcr.microsoft.com/cosmosdb/linux/azure-cosmos-emulator:vnext-preview

# ---- bridge sink (decision D0: Cosmos = full-fidelity content store) ----
# Leave COSMOS_ENDPOINT empty for the file sink (spans land in ./data/spans.jsonl).
# For the emulator profile use: https://cosmos-emulator:8081 (in-network) and
# the emulator's well-known key.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=teamkb-telemetry
COSMOS_CONTAINER=spans

# ---- Azure Monitor (curated pipeline; config-azure.yaml only) ----
# App Insights connection string. Required only when running with
# --config collector/config-azure.yaml.
AZURE_MONITOR_CONNECTION_STRING=

# ---- session identity stamped by the instrumented app (decision D1) ----
# Set these in the AGENT/MCP process env, not here — listed for reference:
#   TEAMKB_SESSION_ID    unique id per agent session
#   TEAMKB_SESSION_NAME  human-readable session group name
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317  (enables telemetry)
