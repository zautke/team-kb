# team-kb config SSoT (C-2). Copy to .env; every consumer interpolates from here.
# Vault root (markdown canonical store)
TEAMKB_VAULT=/absolute/path/to/team-kb-vault
# Embeddings (M1+): OpenAI-compatible endpoint — LM Studio local on target, or tunnel
TEAMKB_EMBED_ENDPOINT=http://127.0.0.1:11434/v1
TEAMKB_EMBED_MODEL=nomic-embed-text
# Neo4j mirror (M2+) — register non-generic ports >10000 in the org port map first (C-1)
TEAMKB_NEO4J_BOLT=
